+/* original instructions of the block being selected; used to find
+ * same-block definitions when folding address arithmetic */
+static Blk *selblk;
+static Ins *selpos;
+
+static int
+accsize(Ins *i)
+{
+	switch (i->op) {
+	case Oloadsb: case Oloadub: case Ostoreb: return 1;
+	case Oloadsh: case Oloaduh: case Ostoreh: return 2;
+	case Oloadsw: case Oloaduw: case Ostorew: case Ostores: return 4;
+	case Ostorel: case Ostored: return 8;
+	case Oload: return KWIDE(i->cls) ? 8 : 4;
+	}
+	return 0;
+}
+
+/* fold "%a = add %base, off" into [base, #off] for a load/store
+ * with off a valid scaled uimm12; the add is deleted once all its
+ * uses have been folded (blocks are selected bottom-up) */
+static void
+foldaddr(Ref *pr, int sz, Fn *fn)
+{
+	Ins *d;
+	Con *c;
+	int64_t off;
+	Mem m;
+
+	if (rtype(*pr) != RTmp || fn->tmp[pr->val].slot != -1)
+		return;
+	for (d=selpos; d>selblk->ins;)
+		if (req((--d)->to, *pr))
+			goto Found;
+	return;
+Found:
+	if (d->op != Oadd || d->cls != Kl
+	|| rtype(d->arg[0]) != RTmp || rtype(d->arg[1]) != RCon
+	|| fn->tmp[d->arg[0].val].slot != -1)
+		return;
+	c = &fn->con[d->arg[1].val];
+	if (c->type != CBits)
+		return;
+	off = c->bits.i;
+	if (off < 0 || off % sz || off / sz > 4095)
+		return;
+	m = (Mem){.base = d->arg[0], .index = R};
+	m.offset.type = CBits;
+	m.offset.bits.i = off;
+	vgrow(&fn->mem, ++fn->nmem);
+	fn->mem[fn->nmem-1] = m;
+	chuse(d->arg[0], +1, fn);
+	chuse(*pr, -1, fn);
+	if (fn->tmp[pr->val].nuse == 0) {
+		chuse(d->arg[0], -1, fn);
+		*d = (Ins){.op = Onop};
+	}
+	*pr = MEM(fn->nmem-1);
+}
+
+static int
+log2p(int64_t n)
+{
+	int l;
+
+	if (n <= 0 || (n & (n-1)))
+		return -1;
+	for (l=0; n>1; n>>=1)
+		l++;
+	return l;
+}
