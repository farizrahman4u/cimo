+/* floating-point constants are loaded once in the start block
+ * and reused, instead of being reloaded at every use */
+typedef struct FCon FCon;
+struct FCon {
+	int64_t bits;
+	int k;
+	Ref tmp;
+};
+static FCon *fcon;
+static uint nfcon;
+
+static Ref
+fconref(int64_t bits, int k, Fn *fn)
+{
+	uint n;
+
+	for (n=0; n<nfcon; n++)
+		if (fcon[n].bits == bits && fcon[n].k == k)
+			return fcon[n].tmp;
+	vgrow(&fcon, ++nfcon);
+	fcon[n] = (FCon){bits, k, newtmp("fcon", k, fn)};
+	return fcon[n].tmp;
+}
+
+static void
+emitfcon(Fn *fn)
+{
+	char buf[32];
+	Con *c;
+	Ref r;
+	uint n;
+	int s;
+
+	for (n=0; n<nfcon; n++) {
+		s = stashbits(fcon[n].bits, KWIDE(fcon[n].k) ? 8 : 4);
+		vgrow(&fn->con, ++fn->ncon);
+		c = &fn->con[fn->ncon-1];
+		sprintf(buf, "\"%sfp%d\"", T.asloc, s);
+		*c = (Con){.type = CAddr};
+		c->sym.id = intern(buf);
+		r = newtmp("isel", Kl, fn);
+		emit(Oload, fcon[n].k, fcon[n].tmp, r, R);
+		emit(Ocopy, Kl, r, CON(c-fn->con), R);
+	}
+}
